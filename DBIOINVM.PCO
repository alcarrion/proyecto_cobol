      ******************************************************************
      * Program:  DBIOINVM.PCO
      * Author:   EQUIPO (LUIS, ALISON, FRANKLIN)
      * Date:     02-05-2025
      * Desc:     Capa de acceso a datos - Tabla INVM
      *           Operaciones segun OPER de INPUT-AREA:
      *             'I' = Movimiento (deposito/retiro) - UPDATE saldo
      *             'C' = Consulta saldo               - SELECT
      *             'D' = Extracto detallado           - SELECT completo
      *           Recibe INPUT-AREA, devuelve OUTPUT-AREA
      * Tectonics: cobc
      ******************************************************************
       IDENTIFICATION DIVISION.
       PROGRAM-ID. DBIOINVM.

       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.

           EXEC SQL INCLUDE SQLCA END-EXEC.

      *=================================================================
      *     HOST VARIABLES PARA SQL EMBEBIDO
      *=================================================================
           EXEC SQL BEGIN DECLARE SECTION END-EXEC.

           01 HV-ID-CLIENTE         PIC 9(08).
           01 HV-COD-MOV            PIC 9(02).
           01 HV-FECHA-ULT-MOV     PIC X(08).
           01 HV-IMPORTE-MOV        PIC S9(10)V99 COMP-3.
           01 HV-SALDO-ACTUAL       PIC S9(10)V99 COMP-3.

           EXEC SQL END DECLARE SECTION END-EXEC.

      *=================================================================
      *     FECHA DEL SISTEMA
      *=================================================================
           01 WS-FECHA-HOY          PIC X(08).

      *=================================================================
      *     CODIGOS DE RETORNO
      *=================================================================
           01 WS-RC-EXITO           PIC 9(02) VALUE 00.
           01 WS-RC-NO-ENCONTRADO   PIC 9(02) VALUE 01.
           01 WS-RC-SALDO-INSUF     PIC 9(02) VALUE 02.
           01 WS-RC-IMPORTE-INV     PIC 9(02) VALUE 04.
           01 WS-RC-ERROR-DB        PIC 9(02) VALUE 99.

       LINKAGE SECTION.

      *=================================================================
      *     PARAMETROS RECIBIDOS DESDE IN0000
      *=================================================================
       01 LS-INPUT-AREA.
           05 LS-OPER               PIC X(01).
           05 LS-ID-CLIENTE         PIC 9(08).
           05 LS-COD-MOV            PIC 9(02).
           05 LS-FECHA-ULT-MOV     PIC X(08).
           05 LS-IMPORTE-MOV        PIC S9(10)V99 COMP-3.
           05 LS-SALDO-ACTUAL       PIC S9(10)V99 COMP-3.

       01 LS-OUTPUT-AREA.
           05 LS-COD-ERROR          PIC 9(02).
           05 LS-MENSAJE            PIC X(50).
           05 LS-OUT-ID-CLIENTE     PIC 9(08).
           05 LS-OUT-COD-MOV        PIC 9(02).
           05 LS-OUT-FECHA-ULT-MOV PIC X(08).
           05 LS-OUT-IMPORTE-MOV    PIC S9(10)V99 COMP-3.
           05 LS-OUT-SALDO-ACTUAL   PIC S9(10)V99 COMP-3.

      ******************************************************************
       PROCEDURE DIVISION USING LS-INPUT-AREA
                                LS-OUTPUT-AREA.
      ******************************************************************

       0000-INICIO.
           MOVE FUNCTION CURRENT-DATE(1:8) TO WS-FECHA-HOY
           INITIALIZE LS-OUTPUT-AREA

           EVALUATE LS-OPER
               WHEN 'I'
                   PERFORM 1000-REGISTRAR-MOVIMIENTO
               WHEN 'C'
                   PERFORM 2000-CONSULTAR-SALDO
               WHEN 'D'
                   PERFORM 3000-EXTRACTO-DETALLADO
               WHEN OTHER
                   MOVE WS-RC-ERROR-DB  TO LS-COD-ERROR
                   MOVE "DBIOINVM: Operacion no reconocida."
                                        TO LS-MENSAJE
           END-EVALUATE
           GOBACK.

      *=================================================================
      *  1000 - REGISTRAR MOVIMIENTO (OPER = 'I')
      *         1. SELECT para traer saldo actual
      *         2. Validar importe y saldo (si es retiro)
      *         3. UPDATE con nuevo saldo y ultimo movimiento
      *=================================================================
       1000-REGISTRAR-MOVIMIENTO.
           MOVE LS-ID-CLIENTE         TO HV-ID-CLIENTE

      *    Traer saldo actual para operar sobre el
           EXEC SQL
               SELECT ID_CLIENTE,
                      COD_ULT_MOV,
                      FECHA_ULT_MOV,
                      IMPORTE_MOV,
                      SALDO_ACTUAL
               INTO  :HV-ID-CLIENTE,
                     :HV-COD-MOV,
                     :HV-FECHA-ULT-MOV,
                     :HV-IMPORTE-MOV,
                     :HV-SALDO-ACTUAL
               FROM   INVM
               WHERE  ID_CLIENTE = :HV-ID-CLIENTE
           END-EXEC

           IF SQLCODE = 100
               MOVE WS-RC-NO-ENCONTRADO TO LS-COD-ERROR
               MOVE "Cuenta no encontrada para ese cliente."
                                        TO LS-MENSAJE
               GOBACK
           END-IF

           IF SQLCODE NOT = 0
               MOVE WS-RC-ERROR-DB    TO LS-COD-ERROR
               MOVE "Error critico al consultar cuenta."
                                      TO LS-MENSAJE
               GOBACK
           END-IF

      *    Validar importe mayor a cero
           IF LS-IMPORTE-MOV <= 0
               MOVE WS-RC-IMPORTE-INV TO LS-COD-ERROR
               MOVE "El importe debe ser mayor a cero."
                                      TO LS-MENSAJE
               GOBACK
           END-IF

      *    Si es retiro: validar saldo suficiente
           IF LS-COD-MOV = 3
               IF LS-IMPORTE-MOV > HV-SALDO-ACTUAL
                   MOVE WS-RC-SALDO-INSUF TO LS-COD-ERROR
                   MOVE "Saldo insuficiente para el retiro."
                                          TO LS-MENSAJE
                   GOBACK
               END-IF
           END-IF

      *    Calcular nuevo saldo segun tipo de movimiento
           EVALUATE LS-COD-MOV
               WHEN 2
                   ADD LS-IMPORTE-MOV  TO HV-SALDO-ACTUAL
               WHEN 3
                   SUBTRACT LS-IMPORTE-MOV FROM HV-SALDO-ACTUAL
           END-EVALUATE

           MOVE LS-COD-MOV            TO HV-COD-MOV
           MOVE LS-IMPORTE-MOV        TO HV-IMPORTE-MOV
           MOVE WS-FECHA-HOY          TO HV-FECHA-ULT-MOV

      *    Actualizar la tabla
           EXEC SQL
               UPDATE INVM
               SET    COD_ULT_MOV   = :HV-COD-MOV,
                      FECHA_ULT_MOV = :HV-FECHA-ULT-MOV,
                      IMPORTE_MOV   = :HV-IMPORTE-MOV,
                      SALDO_ACTUAL  = :HV-SALDO-ACTUAL
               WHERE  ID_CLIENTE    = :HV-ID-CLIENTE
           END-EXEC

           IF SQLCODE = 0
               MOVE WS-RC-EXITO         TO LS-COD-ERROR
               MOVE "Movimiento registrado correctamente."
                                        TO LS-MENSAJE
               MOVE HV-ID-CLIENTE       TO LS-OUT-ID-CLIENTE
               MOVE HV-COD-MOV          TO LS-OUT-COD-MOV
               MOVE HV-FECHA-ULT-MOV   TO LS-OUT-FECHA-ULT-MOV
               MOVE HV-IMPORTE-MOV      TO LS-OUT-IMPORTE-MOV
               MOVE HV-SALDO-ACTUAL     TO LS-OUT-SALDO-ACTUAL
           ELSE
               MOVE WS-RC-ERROR-DB      TO LS-COD-ERROR
               MOVE "Error critico al registrar movimiento."
                                        TO LS-MENSAJE
           END-IF.

      *=================================================================
      *  2000 - CONSULTAR SALDO (OPER = 'C')
      *         SELECT simple, devuelve todos los campos en OUTPUT-AREA
      *=================================================================
       2000-CONSULTAR-SALDO.
           MOVE LS-ID-CLIENTE         TO HV-ID-CLIENTE

           EXEC SQL
               SELECT ID_CLIENTE,
                      COD_ULT_MOV,
                      FECHA_ULT_MOV,
                      IMPORTE_MOV,
                      SALDO_ACTUAL
               INTO  :HV-ID-CLIENTE,
                     :HV-COD-MOV,
                     :HV-FECHA-ULT-MOV,
                     :HV-IMPORTE-MOV,
                     :HV-SALDO-ACTUAL
               FROM   INVM
               WHERE  ID_CLIENTE = :HV-ID-CLIENTE
           END-EXEC

           IF SQLCODE = 0
               MOVE WS-RC-EXITO         TO LS-COD-ERROR
               MOVE "Consulta realizada exitosamente."
                                        TO LS-MENSAJE
               MOVE HV-ID-CLIENTE       TO LS-OUT-ID-CLIENTE
               MOVE HV-COD-MOV          TO LS-OUT-COD-MOV
               MOVE HV-FECHA-ULT-MOV   TO LS-OUT-FECHA-ULT-MOV
               MOVE HV-IMPORTE-MOV      TO LS-OUT-IMPORTE-MOV
               MOVE HV-SALDO-ACTUAL     TO LS-OUT-SALDO-ACTUAL
           ELSE IF SQLCODE = 100
               MOVE WS-RC-NO-ENCONTRADO TO LS-COD-ERROR
               MOVE "No existe cuenta para ese cliente."
                                        TO LS-MENSAJE
           ELSE
               MOVE WS-RC-ERROR-DB      TO LS-COD-ERROR
               MOVE "Error critico en SELECT INVM."
                                        TO LS-MENSAJE
           END-IF.

      *=================================================================
      *  3000 - EXTRACTO DETALLADO (OPER = 'D')
      *         Mismo SELECT que consulta - misma tabla, mismos datos
      *         El formato detallado lo maneja IN0000 en pantalla
      *=================================================================
       3000-EXTRACTO-DETALLADO.
           MOVE LS-ID-CLIENTE         TO HV-ID-CLIENTE

           EXEC SQL
               SELECT ID_CLIENTE,
                      COD_ULT_MOV,
                      FECHA_ULT_MOV,
                      IMPORTE_MOV,
                      SALDO_ACTUAL
               INTO  :HV-ID-CLIENTE,
                     :HV-COD-MOV,
                     :HV-FECHA-ULT-MOV,
                     :HV-IMPORTE-MOV,
                     :HV-SALDO-ACTUAL
               FROM   INVM
               WHERE  ID_CLIENTE = :HV-ID-CLIENTE
           END-EXEC

           IF SQLCODE = 0
               MOVE WS-RC-EXITO         TO LS-COD-ERROR
               MOVE "Extracto generado exitosamente."
                                        TO LS-MENSAJE
               MOVE HV-ID-CLIENTE       TO LS-OUT-ID-CLIENTE
               MOVE HV-COD-MOV          TO LS-OUT-COD-MOV
               MOVE HV-FECHA-ULT-MOV   TO LS-OUT-FECHA-ULT-MOV
               MOVE HV-IMPORTE-MOV      TO LS-OUT-IMPORTE-MOV
               MOVE HV-SALDO-ACTUAL     TO LS-OUT-SALDO-ACTUAL
           ELSE IF SQLCODE = 100
               MOVE WS-RC-NO-ENCONTRADO TO LS-COD-ERROR
               MOVE "No existe cuenta para ese cliente."
                                        TO LS-MENSAJE
           ELSE
               MOVE WS-RC-ERROR-DB      TO LS-COD-ERROR
               MOVE "Error critico en extracto INVM."
                                        TO LS-MENSAJE
           END-IF.

       END PROGRAM DBIOINVM.
