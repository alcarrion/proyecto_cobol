       IDENTIFICATION DIVISION.
       PROGRAM-ID. tkin_hip.
      *================================================================*
      * PROGRAMA PRECOMPILABLE: tkin_hip.sqb                           *
      * PRODUCTO: Hipotecas - Pago de cuota (cartera)                  *
      * RESPONSABILIDAD: Aplicar pago "P" sobre la deuda hipotecaria,  *
      *   recalcular estado y mantener trazabilidad para Trickle Feed. *
      * LLAMADO POR: tkin01 cuando LK-TF-ACCION = "P".                  *
      * REGLAS DE NEGOCIO:                                             *
      *   - SALDO_ACTUAL decrece con cada pago hasta llegar a 0.        *
      *   - Pago que pone al dia hipoteca MOROSA -> ACTIVO + MESES_MORA *
      *     = 0.                                                       *
      *   - Pago que lleva SALDO a 0 (o menos) -> estado CANCELADO.    *
      *   - Pago sobre CASTIGADO o CANCELADO -> rechazado (cod 99).    *
      *   - Si monto > CUOTA_MENSUAL -> aviso prepago.                  *
      *   - Si monto > SALDO_ACTUAL -> aviso sobrepago (cancela).       *
      *================================================================*
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SPECIAL-NAMES.
           DECIMAL-POINT IS COMMA.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
           EXEC SQL INCLUDE SQLCA END-EXEC.

           EXEC SQL BEGIN DECLARE SECTION END-EXEC.
       01  WS-HOST-HIP.
           05 WS-ID-HIPOTECA-SQL    PIC 9(09).
           05 WS-MONTO-PAGO-SQL     PIC S9(13)V99.
           05 WS-SALDO-ACTUAL-SQL   PIC S9(13)V99.
           05 WS-NUEVO-SALDO-SQL    PIC S9(13)V99.
           05 WS-CUOTA-MENS-SQL     PIC S9(13)V99.
           05 WS-ESTADO-SQL         PIC X(20).
           05 WS-NUEVO-ESTADO-SQL   PIC X(20).
           05 WS-COUNT-HIP-SQL      PIC 9(02).
           EXEC SQL END DECLARE SECTION END-EXEC.

       01  WS-AUX.
           05 WS-AUX-SQLCODE        PIC -9(09).

       LINKAGE SECTION.
       01  REG-CTA.
           05 CTA-NRO-CUENTA       PIC 9(09).
           05 CTA-NUM-CREDITO      PIC X(20).
           05 CTA-SALDO-ACTUAL     PIC S9(13)V99.
           05 CTA-MONTO-MOV        PIC 9(13)V99.

           COPY LKTF.

       PROCEDURE DIVISION USING REG-CTA, LK-TRICKLE-FEED-INTERFACE.
       0000-PRINCIPAL.
           MOVE 00 TO LK-TF-COD-RETORNO
           MOVE "OK" TO LK-TF-MENSAJE

      *    Extraer ID_HIPOTECA del campo NUM_CREDITO (X(20) -> 9(09))
           MOVE FUNCTION NUMVAL(CTA-NUM-CREDITO)
                                  TO WS-ID-HIPOTECA-SQL
           MOVE CTA-MONTO-MOV     TO WS-MONTO-PAGO-SQL.

      *----------------------------------------------------------------*
      * Ruteo por accion. tkin_hip solo admite "P" (pago de credito).  *
      *----------------------------------------------------------------*
           EVALUATE LK-TF-ACCION
               WHEN "P"
                   PERFORM 1000-PROCESAR-PAGO

               WHEN OTHER
                   MOVE 99 TO LK-TF-COD-RETORNO
                   MOVE "ERR: ACCION INVALIDA EN HIP"
                       TO LK-TF-MENSAJE
           END-EVALUATE.

           GOBACK.

      *================================================================*
      * 1000 - PROCESAR PAGO DE HIPOTECA                               *
      *================================================================*
       1000-PROCESAR-PAGO.
      *    1. Consultar hipoteca (saldo, cuota, estado)
           MOVE 0 TO WS-COUNT-HIP-SQL
           EXEC SQL
               SELECT COUNT(*), SALDO_ACTUAL,
                      CUOTA_MENSUAL, ESTADO
               INTO   :WS-COUNT-HIP-SQL,
                      :WS-SALDO-ACTUAL-SQL,
                      :WS-CUOTA-MENS-SQL,
                      :WS-ESTADO-SQL
               FROM   hipotecas
               WHERE  ID_HIPOTECA = :WS-ID-HIPOTECA-SQL
               GROUP BY SALDO_ACTUAL, CUOTA_MENSUAL, ESTADO
           END-EXEC

           IF SQLCODE NOT = 0 AND SQLCODE NOT = 100
               MOVE SQLCODE TO WS-AUX-SQLCODE
               MOVE 99 TO LK-TF-COD-RETORNO
               STRING "ERR DB CONSULTA HIPOTECA SQLCODE: "
                          DELIMITED BY SIZE
                      WS-AUX-SQLCODE
                          DELIMITED BY SIZE
                   INTO LK-TF-MENSAJE
               EXIT PARAGRAPH
           END-IF

           IF WS-COUNT-HIP-SQL = 0
               MOVE 01 TO LK-TF-COD-RETORNO
               MOVE "HIPOTECA NO EXISTE" TO LK-TF-MENSAJE
               EXIT PARAGRAPH
           END-IF

      *    2. Validar estados que no admiten pago
           IF WS-ESTADO-SQL = "CANCELADO"
               MOVE 99 TO LK-TF-COD-RETORNO
               MOVE "ERR: HIPOTECA YA CANCELADA"
                   TO LK-TF-MENSAJE
               EXIT PARAGRAPH
           END-IF

           IF WS-ESTADO-SQL = "CASTIGADO"
               MOVE 99 TO LK-TF-COD-RETORNO
               MOVE "ERR: HIPOTECA CASTIGADA NO ADMITE PAGO"
                   TO LK-TF-MENSAJE
               EXIT PARAGRAPH
           END-IF

      *    3. Calcular nuevo saldo
           COMPUTE WS-NUEVO-SALDO-SQL =
                   WS-SALDO-ACTUAL-SQL - WS-MONTO-PAGO-SQL

      *    4. Avisos de prepago / sobrepago (no son errores)
           IF WS-MONTO-PAGO-SQL > WS-SALDO-ACTUAL-SQL
               MOVE "WARN: SOBREPAGO - CANCELA Y QUEDA EXCEDENTE"
                   TO LK-TF-MENSAJE
           ELSE
               IF WS-MONTO-PAGO-SQL > WS-CUOTA-MENS-SQL
                   MOVE "WARN: PREPAGO - MONTO EXCEDE LA CUOTA"
                       TO LK-TF-MENSAJE
               END-IF
           END-IF

      *    5. Determinar nuevo estado y evitar saldo negativo
           IF WS-NUEVO-SALDO-SQL <= 0
               MOVE "CANCELADO" TO WS-NUEVO-ESTADO-SQL
               MOVE 0           TO WS-NUEVO-SALDO-SQL
           ELSE
               IF WS-ESTADO-SQL = "MOROSO"
                   MOVE "ACTIVO" TO WS-NUEVO-ESTADO-SQL
               ELSE
                   MOVE WS-ESTADO-SQL TO WS-NUEVO-ESTADO-SQL
               END-IF
           END-IF

      *    6. Persistir cambios. MESES_MORA se resetea solo si el
      *       nuevo estado es ACTIVO o CANCELADO; sino se conserva.
           EVALUATE WS-NUEVO-ESTADO-SQL
               WHEN "ACTIVO"
               WHEN "CANCELADO"
                   EXEC SQL
                       UPDATE hipotecas
                       SET    SALDO_ACTUAL = :WS-NUEVO-SALDO-SQL,
                              ESTADO       = :WS-NUEVO-ESTADO-SQL,
                              MESES_MORA   = 0,
                              FECHA_ULT_PAGO = CURDATE()
                       WHERE  ID_HIPOTECA = :WS-ID-HIPOTECA-SQL
                   END-EXEC

               WHEN OTHER
                   EXEC SQL
                       UPDATE hipotecas
                       SET    SALDO_ACTUAL = :WS-NUEVO-SALDO-SQL,
                              ESTADO       = :WS-NUEVO-ESTADO-SQL,
                              FECHA_ULT_PAGO = CURDATE()
                       WHERE  ID_HIPOTECA = :WS-ID-HIPOTECA-SQL
                   END-EXEC
           END-EVALUATE

           IF SQLCODE NOT = 0
               MOVE SQLCODE TO WS-AUX-SQLCODE
               MOVE 99 TO LK-TF-COD-RETORNO
               STRING "ERR DB UPDATE HIPOTECA SQLCODE: "
                          DELIMITED BY SIZE
                      WS-AUX-SQLCODE
                          DELIMITED BY SIZE
                   INTO LK-TF-MENSAJE
           END-IF.
