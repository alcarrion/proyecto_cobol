IDENTIFICATION DIVISION.
       PROGRAM-ID. DBIOBORM.
      *================================================================*
      * COMPONENTE: DBIOBORM.sqb (PERSISTENCIA - HIPOTECAS Y PRESTAMOS)*
      * ACCESO    : SQL Embebido (ESQL) para MariaDB / MySQL           *
      * ADAPTACIÓN: TCS Ecuador Nivel 1000 - Amortización e Intereses  *
      *================================================================*

       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
           
           EXEC SQL INCLUDE SQLCA END-EXEC.

           EXEC SQL BEGIN DECLARE SECTION END-EXEC.
           *> Variables de Host para la tabla 'hipotecas'
           01  DB-BORM-ID-HIPOTECA    PIC 9(08).
           01  DB-BORM-ID-CLIENTE     PIC 9(08).
           01  DB-BORM-CTA-DEBITO     PIC 9(08).
           01  DB-BORM-MONTO-PREST    PIC S9(13)V99 COMP-3.
           01  DB-BORM-SALDO-DEUDA    PIC S9(13)V99 COMP-3.
           01  DB-BORM-TASA-ANUAL     PIC S9(03)V9999 COMP-3.
           01  DB-BORM-CUOTA-MENS     PIC S9(13)V99 COMP-3.
           01  DB-BORM-MESES-MORA     PIC 9(03).
           01  DB-BORM-ESTADO         PIC X(15).
           01  DB-BORM-FECHA-VENC     PIC X(10).
           EXEC SQL END DECLARE SECTION END-EXEC.

           *> Variables auxiliares matemáticas para cálculo de dividendos
           01  WS-AUX-TASA-MENSUAL    PIC S9(03)V999999 COMP-3.
           01  WS-INTERES-DEL-MES     PIC S9(13)V99     COMP-3.
           01  WS-ABONO-A-CAPITAL     PIC S9(13)V99     COMP-3.
           01  WS-NUEVO-SALDO-DEUDA   PIC S9(13)V99     COMP-3.

       LINKAGE SECTION.
           COPY BORMREC.
           COPY LKCIF.

       PROCEDURE DIVISION USING REG-BORM, LK-DATOS-SESION, 
                                  LK-DATOS-TRANSACCION.

       0000-PRINCIPAL.
           MOVE '00  ' TO LK-COD-RETORNO.
           MOVE SPACES TO LK-MENSAJE.

           EVALUATE LK-ACCION-DB
               WHEN 'C'
                   PERFORM 1000-CONSULTAR-HIPOTECA
               WHEN 'M'
                   PERFORM 2000-PROCESAR-PAGO-MENSUAL
               WHEN 'K'  *> Letra K para ejecutar el Castigo de Mora
                   PERFORM 3000-REGISTRAR-CASTIGO-MORA
               WHEN OTHER
                   MOVE 'E999' TO LK-COD-RETORNO
                   MOVE "ERROR: ACCION OPERATIVA NO SOPORTADA" 
                     TO LK-MENSAJE
           END-EVALUATE.
           GOBACK.

       1000-CONSULTAR-HIPOTECA.
           MOVE BORM-ID-CLIENTE TO DB-BORM-ID-CLIENTE.

           EXEC SQL
               SELECT ID_HIPOTECA, CUENTA_DEBITO, MONTO_PRESTAMO, 
                      SALDO_DEUDA, TASA_ANUAL, CUOTA_MENSUAL, 
                      MESES_MORA, ESTADO_PRESTAMO, FECHA_VENCIMIENTO
               INTO  :DB-BORM-ID-HIPOTECA, :DB-BORM-CTA-DEBITO, 
                     :DB-BORM-MONTO-PREST, :DB-BORM-SALDO-DEUDA, 
                     :DB-BORM-TASA-ANUAL, :DB-BORM-CUOTA-MENS, 
                     :DB-BORM-MESES-MORA, :DB-BORM-ESTADO, 
                     :DB-BORM-FECHA-VENC
               FROM  hipotecas
               WHERE ID_CLIENTE = :DB-BORM-ID-CLIENTE
           END-EXEC.

           PERFORM 9000-EVALUAR-SQLSTATE.

           IF LK-EXITO
               MOVE DB-BORM-ID-HIPOTECA  TO BORM-ID-HIPOTECA
               MOVE DB-BORM-ID-CLIENTE   TO BORM-ID-CLIENTE
               MOVE DB-BORM-CTA-DEBITO   TO BORM-CUENTA-DEBITO
               MOVE DB-BORM-MONTO-PREST  TO BORM-MONTO-PRESTAMO
               MOVE DB-BORM-SALDO-DEUDA  TO BORM-SALDO-DEUDA
               MOVE DB-BORM-TASA-ANUAL   TO BORM-TASA-ANUAL
               MOVE DB-BORM-CUOTA-MENS   TO BORM-CUOTA-MENSUAL
               MOVE DB-BORM-MESES-MORA   TO BORM-MESES-MORA
               MOVE DB-BORM-ESTADO       TO BORM-ESTADO-PRESTAMO
               MOVE DB-BORM-FECHA-VENC   TO BORM-FECHA-VENCIMIENTO
               MOVE "REGISTRO DE HIPOTECA CARGADO AL LINKAGE" TO LK-MENSAJE
           END-IF.

       2000-PROCESAR-PAGO-MENSUAL.
           MOVE BORM-ID-HIPOTECA TO DB-BORM-ID-HIPOTECA.

           *> REVISAMOS PRIMERO EL SALDO VIGENTE DIRECTO EN LA BASE
           EXEC SQL
               SELECT SALDO_DEUDA, TASA_ANUAL, CUOTA_MENSUAL, MESES_MORA,
                      ESTADO_PRESTAMO
               INTO  :DB-BORM-SALDO-DEUDA, :DB-BORM-TASA-ANUAL, 
                     :DB-BORM-CUOTA-MENS, :DB-BORM-MESES-MORA, 
                     :DB-BORM-ESTADO
               FROM  hipotecas
               WHERE ID_HIPOTECA = :DB-BORM-ID-HIPOTECA
           END-EXEC.

           PERFORM 9000-EVALUAR-SQLSTATE.
           IF NOT LK-EXITO EXIT PARAGRAPH.

           *> VALIDACIÓN 1: VERIFICAR QUE EL PRESTAMO NO ESTÉ YA CANCELADO
           IF DB-BORM-ESTADO = 'PAGADO'
               MOVE 'E001' TO LK-COD-RETORNO
               MOVE "COMPLEMENTO: LA OPERACION YA SE ENCUENTRA PAGADA" 
                 TO LK-MENSAJE
               EXIT PARAGRAPH
           END-IF.

           *> 2. CÓMPUTO CIENTÍFICO DE INTERESES SOBRE SALDO
           *> Dividimos la tasa anual para los 12 meses del año
           COMPUTE WS-AUX-TASA-MENSUAL = DB-BORM-TASA-ANUAL / 12 / 100.
           
           *> Multiplicamos la tasa mensual por el saldo de la deuda actual
           COMPUTE WS-INTERES-DEL-MES ROUNDED = 
                   DB-BORM-SALDO-DEUDA * WS-AUX-TASA-MENSUAL.

           *> VALIDACIÓN 2: ASEGURAR QUE LA CUOTA CUBRA AL MENOS EL INTERÉS
           IF DB-BORM-CUOTA-MENS <= WS-INTERES-DEL-MES
               MOVE 'E001' TO LK-COD-RETORNO
               MOVE "ERROR CORE: CUOTA INSUFICIENTE PARA AMORTIZAR" 
                 TO LK-MENSAJE
               EXIT PARAGRAPH
           END-IF.

           *> 3. DETERMINACIÓN DEL ABONO REAL A CAPITAL
           COMPUTE WS-ABONO-A-CAPITAL = 
                   DB-BORM-CUOTA-MENS - WS-INTERES-DEL-MES.

           COMPUTE WS-NUEVO-SALDO-DEUDA = 
                   DB-BORM-SALDO-DEUDA - WS-ABONO-A-CAPITAL.

           *> VALIDACIÓN 3: CONTROL DE CIERRE DE CRÉDITO
           IF WS-NUEVO-SALDO-DEUDA <= 0
               MOVE 0 TO WS-NUEVO-SALDO-DEUDA
               MOVE 'PAGADO' TO DB-BORM-ESTADO
               MOVE 0 TO DB-BORM-MESES-MORA
           ELSE
               *> Si venía arrastrando mora y pagó la cuota entera, se reduce
               IF DB-BORM-MESES-MORA > 0
                   SUBTRACT 1 FROM DB-BORM-MESES-MORA
               END-IF
               
               IF DB-BORM-MESES-MORA = 0
                   MOVE 'ACTIVO' TO DB-BORM-ESTADO
               ELSE
                   MOVE 'MOROSO' TO DB-BORM-ESTADO
               END-IF
           END-IF.

           *> TRASPASAMOS LOS RESULTADOS CALCULADOS A LAS VARIABLES HOST
           MOVE WS-NUEVO-SALDO-DEUDA TO DB-BORM-SALDO-DEUDA.

           EXEC SQL
               UPDATE hipotecas
               SET    SALDO_DEUDA     = :DB-BORM-SALDO-DEUDA,
                      MESES_MORA      = :DB-BORM-MESES-MORA,
                      ESTADO_PRESTAMO = :DB-BORM-ESTADO
               WHERE  ID_HIPOTECA     = :DB-BORM-ID-HIPOTECA
           END-EXEC.

           PERFORM 9000-EVALUAR-SQLSTATE.
           IF LK-EXITO
               MOVE DB-BORM-SALDO-DEUDA TO BORM-SALDO-DEUDA
               MOVE DB-BORM-MESES-MORA  TO BORM-MESES-MORA
               MOVE DB-BORM-ESTADO      TO BORM-ESTADO-PRESTAMO
               MOVE "AMORTIZACION DE CREDITO APLICADA CORRECTAMENTE" 
                 TO LK-MENSAJE
           END-IF.

       3000-REGISTRAR-CASTIGO-MORA.
           MOVE BORM-ID-HIPOTECA TO DB-BORM-ID-HIPOTECA.

           EXEC SQL
               UPDATE hipotecas
               SET    ESTADO_PRESTAMO = 'CASTIGADO',
                      MESES_MORA      = MESES_MORA + 1
               WHERE  ID_HIPOTECA     = :DB-BORM-ID-HIPOTECA
           END-EXEC.

           PERFORM 9000-EVALUAR-SQLSTATE.
           IF LK-EXITO
               MOVE 'CASTIGADO' TO BORM-ESTADO-PRESTAMO
               MOVE 'S'         TO LK-ESTADO-MORA
               MOVE "OPERACION MARCADA EN COACTIVA POR MOROSIDAD CRITICA" 
                 TO LK-MENSAJE
           END-IF.

       9000-EVALUAR-SQLSTATE.
           EVALUATE SQLSTATE
               WHEN '00000'
                   MOVE '00  ' TO LK-COD-RETORNO
               WHEN '02000'
                   MOVE 'E404' TO LK-COD-RETORNO
                   MOVE "ID DE OPERACION HIPOTECARIA NO LOCALIZADA" 
                     TO LK-MENSAJE
               WHEN OTHER
                   MOVE 'E999' TO LK-COD-RETORNO
                   MOVE "ERROR CRITICO DE PERSISTENCIA EN OPERACION BORM" 
                     TO LK-MENSAJE
           END-EVALUATE.