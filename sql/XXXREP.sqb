       IDENTIFICATION DIVISION.
       PROGRAM-ID. XXXREP.
      *==========================================================
      * FASE 30: GENERACI�N DE ARCHIVO DE SALIDA CON RESULTADOS
      *==========================================================

       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT ARCHIVO-SALIDA ASSIGN TO WS-RUTA-FINAL
           ORGANIZATION IS LINE SEQUENTIAL
           FILE STATUS IS WS-FS.

       DATA DIVISION.
       FILE SECTION.
       FD  ARCHIVO-SALIDA.
       01  REG-SALIDA             PIC X(600).

       WORKING-STORAGE SECTION.
           EXEC SQL INCLUDE SQLCA END-EXEC.

           EXEC SQL BEGIN DECLARE SECTION END-EXEC.
       01  WS-TF06-REGS.
           05 WS-DATOS-TX-SQL      PIC X(500).
           05 WS-ESTADO-SQL        PIC 9(01).
           05 WS-COD-ERR-SQL       PIC X(04).
           05 WS-ID-LOTE-SQL       PIC 9(09).
           EXEC SQL END DECLARE SECTION END-EXEC.

       01  WS-CONTROL-REP.
           05 WS-DIR-SALIDA        PIC X(250).
           05 WS-RUTA-FINAL        PIC X(250).
           05 WS-STATUS-TXT        PIC X(05).
           05 WS-LINEA-OUT         PIC X(600).
           05 WS-FS                PIC X(02).
           05 WS-EOF-REP           PIC X(01) VALUE 'N'.

       LINKAGE SECTION.
           COPY LKCIF.
       01  WS-TFFM-VARS.
           05 WS-ID-LOTE           PIC 9(09).
           05 WS-NOMBRE-ARCHIVO    PIC X(50).
           05 WS-FASE              PIC X(02).
           05 WS-ESTADO-REPLICA    PIC X(01).
           05 WS-TIPO-PROG         PIC X(03).
           05 WS-FECHA-SIST        PIC X(10).

       PROCEDURE DIVISION USING WS-TFFM-VARS, LK-DATOS-TRANSACCION.
       0000-PRINCIPAL.
      * 1. Construcci�n de ruta de salida (Ajustada a relativa)
           INITIALIZE WS-DIR-SALIDA, WS-RUTA-FINAL
           
           STRING "..\banco\spool\Interfaces\BATCH-UPLOAD-S\"
                  "TRICKLE-FEED-REPORT\"
                  DELIMITED BY SIZE 
                  INTO WS-DIR-SALIDA.

           STRING WS-DIR-SALIDA     DELIMITED BY "  "
                  WS-NOMBRE-ARCHIVO DELIMITED BY SPACE
                  ".out"            DELIMITED BY SIZE
                  INTO WS-RUTA-FINAL

           DISPLAY "XXXREP - GENERANDO REPORTE EN: " WS-RUTA-FINAL

      * 2. Apertura de archivo de reporte
           OPEN OUTPUT ARCHIVO-SALIDA
           IF WS-FS NOT = "00"
               DISPLAY "ERROR AL CREAR ARCHIVO DE REPORTE: " WS-FS
               MOVE 99 TO LK-COD-RETORNO
               GOBACK
           END-IF

      * 3. Cursor de resultados
           MOVE WS-ID-LOTE TO WS-ID-LOTE-SQL
           EXEC SQL
               DECLARE CUR_REP CURSOR FOR
               SELECT DATOS_TX, ESTADO, COD_ERROR
               FROM TF06
               WHERE ID_LOTE = :WS-ID-LOTE-SQL
           END-EXEC

           EXEC SQL OPEN CUR_REP END-EXEC

           PERFORM 1000-FETCH-REPORTE
           PERFORM UNTIL WS-EOF-REP = 'Y'
               PERFORM 2000-ESCRIBIR-LINEA
               PERFORM 1000-FETCH-REPORTE
           END-PERFORM

           EXEC SQL CLOSE CUR_REP END-EXEC
           CLOSE ARCHIVO-SALIDA

           DISPLAY "XXXREP - REPORTE FINALIZADO EXITOSAMENTE."
           MOVE 0 TO LK-COD-RETORNO
           GOBACK.

       1000-FETCH-REPORTE.
           EXEC SQL
               FETCH CUR_REP INTO :WS-DATOS-TX-SQL, :WS-ESTADO-SQL,
                                  :WS-COD-ERR-SQL
           END-EXEC
           IF SQLCODE = 100 OR SQLCODE < 0
               MOVE 'Y' TO WS-EOF-REP
           END-IF.

       2000-ESCRIBIR-LINEA.
           EVALUATE WS-ESTADO-SQL
               WHEN 4
                   MOVE "OK"    TO WS-STATUS-TXT
               WHEN 7
                   MOVE "ERROR" TO WS-STATUS-TXT
               WHEN OTHER
                   MOVE "UNKN"  TO WS-STATUS-TXT
           END-EVALUATE

           INITIALIZE WS-LINEA-OUT
           STRING WS-DATOS-TX-SQL   DELIMITED BY "  "
                  "|" WS-STATUS-TXT DELIMITED BY SPACE
                  "|" WS-COD-ERR-SQL DELIMITED BY SPACE
                  INTO WS-LINEA-OUT

           WRITE REG-SALIDA FROM WS-LINEA-OUT.
